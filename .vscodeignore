# Source files
.vscode/**
.vscode-test/**
src/**
.gitignore
.yarnrc
vsc-extension-quickstart.md
**/tsconfig.json
**/.eslintrc.json
**/*.map
**/*.ts

# Build artifacts
!out/**/*.js

# Documentation (exclude architecture docs, keep user docs)
ARCHITECTURE.md
CRITICAL_FIX_SYNC.md

# Git and CI
.git/**
.github/**

# Development files
.editorconfig

# Exclude devDependencies from node_modules (keep production dependencies)
node_modules/@types/**
node_modules/@typescript-eslint/**
node_modules/@vscode/vsce/**
node_modules/eslint/**
node_modules/typescript/**

# Tests
**/test/**
**/*.test.ts
**/*.spec.ts

# IDE
.idea/**
*.swp
*.swo
*~

# Logs and temp files
*.log
.DS_Store
Thumbs.db

# Package management
package-lock.json
yarn.lock
pnpm-lock.yaml

# Keep necessary files for users
!README.md
!CHANGELOG.md
!LICENSE
!resources/**
